{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Locall",
    "homepage": "https://alvaritoo89.github.io/Locall/",
    "license": "Apache-2.0",
    "shortDescription": "IA local en tu equipo",
    "resources": {
      "../../target/release/locall.exe": "locall.exe",
      "../../target/paquete/motor/*": "motor/",
      "../../LICENSE": "LICENSE.txt",
      "../../target/paquete/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "instalador/installer.nsi",
        "installerHooks": "instalador/ganchos.nsh"
      }
    }
  }
}
