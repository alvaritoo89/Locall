# Finales de línea uniformes (LF) dentro del repositorio, sea cual sea el sistema operativo.
* text=auto eol=lf

# Archivos binarios: nunca tocar
*.png binary
*.ico binary
*.gguf binary

# Archivos firmados (catálogo y sus firmas): se guardan byte a byte, sin convertir finales de línea. Si Git los
# tocara, la firma dejaría de valer.
catalogo/** -text
crates/locall-catalogo/tests/datos/** -text
crates/locall-core/tests/datos/** -text
