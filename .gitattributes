# Consistent line endings (LF) inside the repository, whatever the operating system.
* text=auto eol=lf

# Binary files: never touch
*.png binary
*.ico binary
*.gguf binary

# Signed files (the catalog and its signatures): stored byte for byte, with no line-ending conversion. If Git
# touched them, the signature would no longer be valid.
catalogo/** -text
crates/locall-catalogo/tests/datos/** -text
crates/locall-core/tests/datos/** -text

# Website fonts
*.woff2 binary
